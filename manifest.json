{
  "manifest_version": 3,
  "name": "Move to Private Window",
  "version": "2.2",
  "description": "Open an existing tab in a private session window.",
  "homepage_url": "https://github.com/joshuacant/move_to_private",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },

  "permissions": [
    "webNavigation",
    "tabs",
    "sessions",
    "menus",
    "history",
    "storage"
  ],

  "options_ui": {
    "page": "options/options.html"
  },

  "background": {
    "scripts": [ 
      "js/background.js" 
    ]
  },
  
  "browser_specific_settings": {
    "gecko": {
      "id": "tst-open_in_private@dontpokebadgers.com",
      "strict_min_version": "150.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
